{
  "name": "ai-memory-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && next dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently -n \"next,express\" -c \"blue,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "cd frontend && next build",
    "build": "npm run build:frontend",
    "start:frontend": "cd frontend && next start",
    "start:backend": "cd backend && npm start",
    "start": "concurrently -n \"next,express\" -c \"blue,green\" \"npm run start:frontend\" \"npm run start:backend\"",
    "lint": "cd frontend && eslint ."
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.511.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "concurrently": "^10.0.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
